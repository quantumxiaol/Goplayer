RL_MIN_MOVES_BEFORE_PASS=""    # 留空按棋盘选择 9/13/19 路：50/100/180；JSON/CLI 可覆盖
ALPHAZERO_CHECKPOINT_DIR="checkpoints"  # GUI按棋盘大小自动读取 {dir}/{size}x{size}/best_model.pth
# ALPHAZERO_CHECKPOINT_PATH="checkpoints/13x13/bs13_v2/best_model.pth"  # 新训练按 run 隔离，需指定路径
ALPHAZERO_MIN_MOVES_BEFORE_PASS="18"  # GUI中AlphaZero早期不pass（9路推荐18）
