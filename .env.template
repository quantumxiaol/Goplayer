OPENAI_MODEL="qwen-max-latest"
OPENAI_API_KEY=
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# RL training / local AlphaZero
RL_DEVICE="auto"               # auto / cpu / cuda / mps
RL_CHECKPOINT_DIR="checkpoints"
RL_LOG_DIR="logs"
RL_RUN_NAME=""                 # 同时隔离权重和日志；留空用时间戳，同名已有目录会拒绝运行
